{
    "name": "basilisk-desktop",
    "version": "2.0.0",
    "description": "Basilisk — AI Red Teaming Desktop Application",
    "homepage": "https://github.com/regaan/basilisk",
    "repository": {
        "type": "git",
        "url": "https://github.com/regaan/basilisk.git"
    },
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "dev": "electron .",
        "test:e2e": "node --test tests/e2e-smoke.js",
        "benchmark": "node ../benchmarks/desktop/run.js",
        "dist": "electron-builder",
        "build": "electron-builder",
        "build:linux": "electron-builder --linux",
        "build:win": "electron-builder --win",
        "build:mac": "electron-builder --mac",
        "pack": "electron-builder --dir"
    },
    "keywords": [
        "ai",
        "red-team",
        "llm",
        "security",
        "pentesting",
        "vulnerability"
    ],
    "author": "Regaan <contact@rothackers.com> (https://rothackers.com)",
    "license": "AGPL-3.0",
    "type": "commonjs",
    "devDependencies": {
        "@electron/notarize": "3.1.1",
        "electron": "43.2.0",
        "electron-builder": "26.15.3"
    },
    "dependencies": {
        "electron-updater": "6.8.9"
    },
    "build": {
        "appId": "com.rothackers.basilisk",
        "productName": "Basilisk",
        "icon": "build/icon.png",
        "linux": {
            "target": [
                "pacman",
                "AppImage",
                "deb",
                "rpm"
            ],
            "icon": "build/icon.png",
            "executableName": "basilisk",
            "artifactName": "basilisk-${version}.${ext}",
            "category": "Security",
            "maintainer": "Rot Hackers <contact@rothackers.com>"
        },
        "win": {
            "target": "nsis",
            "icon": "build/icon.ico",
            "signtoolOptions": {
                "publisherName": "Rot Hackers"
            }
        },
        "mac": {
            "target": "dmg",
            "icon": "build/icon.icns",
            "category": "public.app-category.developer-tools",
            "hardenedRuntime": true,
            "gatekeeperAssess": false,
            "entitlements": "build/entitlements.mac.plist",
            "entitlementsInherit": "build/entitlements.mac.plist"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "allowElevation": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "license": "LICENSE.txt"
        },
        "publish": {
            "provider": "github",
            "owner": "regaan",
            "repo": "basilisk"
        },
        "pacman": {
            "depends": [
                "hicolor-icon-theme"
            ]
        },
        "directories": {
            "output": "dist"
        },
        "files": [
            "main.js",
            "preload.js",
            "src/**/*"
        ],
        "afterSign": "scripts/notarize.js",
        "extraResources": [
            {
                "from": "bin",
                "to": "bin",
                "filter": [
                    "**/*"
                ]
            },
            {
                "from": "build/release-channel.json",
                "to": "metadata/release-channel.json"
            }
        ]
    }
}
